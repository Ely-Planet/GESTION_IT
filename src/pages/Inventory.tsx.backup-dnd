);

function handleColumnDragEnd(
  event: DragEndEvent
) {
  const { active, over } = event;

  if (!over || active.id === over.id) {
    return;
  }

  setColumnOrder((currentOrder) => {
    const oldIndex =
      currentOrder.indexOf(String(active.id));

    const newIndex =
      currentOrder.indexOf(String(over.id));

    if (oldIndex === -1 || newIndex === -1) {
      return currentOrder;
    }

    return arrayMove(
      currentOrder,
      oldIndex,
      newIndex
    );
  });
}

function openUserAssign(item: HardwareItem) {
console.log('USER', item);
  setSelectedHardware(item);
  setShowAssignUser(true);
}

async function openGroupAssign(
  item: HardwareItem
) {

  const res = await fetch(
    '/api/microsoft-onboarding-services'
  );

  const groups = await res.json();

  setMicrosoftGroups(groups);

  setSelectedHardware(item);

  setShowAssignGroup(true);
}



async function unassignHardware(item: HardwareItem) {

  if (
    !confirm(
      `Désaffecter ${item.title ?? item.serial_number ?? ''} ?`
    )
  ) {
    return;
  }

  const res = await fetch(
    '/api/hardware-assignments/unassign',
    {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        hardware_item_id: item.id,
      }),
    }
  );

  if (!res.ok) {
    alert('Erreur de désaffectation');
    return;
  }

  data.reload();
}

useEffect(() => {

  if (
    profile?.mail ||
    profile?.email
  ) {
    loadPreferences();
  }

}, [profile]);

async function loadPreferences() {
  try {

    if (!profile?.mail && !profile?.email) {
      return;
    }

    const email =
      profile.mail ??
      profile.email;

    const res = await fetch(
      `/api/inventory/preferences/${encodeURIComponent(email)}`
    );

    if (!res.ok) return;

    const prefs = await res.json();

    if (
      !prefs.visibleColumns ||
      !prefs.columnOrder
    ) {

      const defaultColumns =
        allColumns.map(c => c.key);

      setVisibleColumns(defaultColumns);
      setColumnOrder(defaultColumns);

      return;
    }

    setVisibleColumns(
      prefs.visibleColumns
    );

    setColumnOrder(
      prefs.columnOrder
    );

  } catch (error) {
    console.error(error);
  }
}

async function savePreferences() {

  try {

    if (
      !visibleColumns.length ||
      !columnOrder.length
    ) {
      return;
    }

    const email =
      profile?.mail ??
      profile?.email;

    if (!email) {
      return;
    }

    await fetch(
      '/api/inventory/preferences',
      {
        method: 'POST',
        headers: {
          'Content-Type':
            'application/json'
        },
        body: JSON.stringify({

          email,

          visibleColumns,

          columnOrder

        })
      }
    );

  } catch (error) {
    console.error(error);
  }
}

useEffect(() => {

  savePreferences();

}, [
  visibleColumns,
  columnOrder
]);

