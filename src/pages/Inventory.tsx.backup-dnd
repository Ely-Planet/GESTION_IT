const [purchaseValue, setPurchaseValue] = useState('');

const [supplierId, setSupplierId] = useState('');
const [budgetId, setBudgetId] = useState('');

const [warrantyExpirationDate, setWarrantyExpirationDate] = useState('');
const [assetNumber, setAssetNumber] = useState('');

  useEffect(() => {
    if (!item) {
      setCategoryId('');
      setTitle('');
      setReference('');
      setSerial('');
      setBrand('');
      setModel('');
      setStatus('in_stock');
      setIntuneId('');
      setAteraId('');
      setPurchaseDate('');
      setNotes('');
      setQuantity(1);
      setOsId('');
      setProcessorId('');
      setMemoryId('');
      setSizeId('');
      setHdmi(false);
      setDisplayport(false);
setUsbC(false);      
setInvoiceNumber('');
      setPurchaseValue('');
      setSupplierId('');
      setBudgetId('');
      setWarrantyExpirationDate('');
      setAssetNumber('');
      return;
    }

    setCategoryId(item.category_id ?? '');
    setTitle(item.title ?? '');
    setReference(item.reference ?? '');
    setSerial(item.serial_number ?? '');
    setBrand(item.brand ?? '');
    setModel(item.model ?? '');
    setStatus(item.status);
    setIntuneId(item.intune_device_id ?? '');
    setAteraId(item.atera_ticket_id ?? '');
    setPurchaseDate(item.purchase_date ?? '');
    setNotes(item.notes ?? '');
    setQuantity(1);
    setOsId(item.os_id ?? '');
    setProcessorId(item.processor_id ?? '');
    setMemoryId(item.memory_id ?? '');
    setSizeId(item.size_id ?? '');
    setHdmi(Boolean(item.hdmi));
    setDisplayport(Boolean(item.displayport));
setUsbC(Boolean(item.usbc));    
setInvoiceNumber(item.invoice_number ?? '');
    setPurchaseValue(item.purchase_value != null ? String(item.purchase_value) : '');
    setSupplierId(item.supplier_id ?? '');
    setBudgetId(item.budget_id ?? '');
    setWarrantyExpirationDate(item.warranty_expiration_date ?? '');
    setAssetNumber(item.asset_number ?? '');
  }, [item]);



  async function onSubmit(e: FormEvent) {
    e.preventDefault();
    setBusy(true);
    setError(null);

    try {
      const basePayload = {
        category_id: categoryId,
        title: title || null,
        reference: reference || null,
        serial_number: serial || null,
        brand: brand || null,
        model: model || null,
        os_id: osId || null,
        processor_id: processorId || null,
        memory_id: memoryId || null,
        size_id: sizeId || null,
        hdmi,
        displayport,
        usbc: usbC,
        status,
        purchase_date: purchaseDate || null,
        invoice_number: invoiceNumber || null,
        purchase_value: purchaseValue ? Number(purchaseValue) : null,
        supplier_id: supplierId || null,
        budget_id: budgetId || null,
        warranty_expiration_date: warrantyExpirationDate || null,
        asset_number: assetNumber || null,
        intune_device_id: intuneId || null,
        atera_ticket_id: ateraId || null,
        notes: notes || null,
      };

      const body = item
        ? basePayload
        : Array.from({ length: Math.max(1, quantity) }).map((_, i) => ({
            ...basePayload,
            serial_number:
              quantity > 1 && serial
                ? `${serial}-${String(i + 1).padStart(2, '0')}`
                : serial || null,
          }));

      const res = await fetch(
        item ? `/api/hardware-items/${item.id}` : '/api/hardware-items',
        {
          method: item ? 'PUT' : 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(body),
        }
      );

      if (!res.ok) {
        const err = await res.json().catch(() => ({
          error: item ? 'Erreur modification matériel' : 'Erreur création matériel',
        }));
        throw new Error(
          err.error ?? (item ? 'Erreur modification matériel' : 'Erreur création matériel')
        );
      }

      const result = await res.json();

      if (item) {
        await logAudit(
          'update',
          'hardware',
          result.id,
          {},
          profile?.display_name
        ).catch(console.error);
      } else {
        for (const r of result ?? []) {
          await logAudit(
            'create',
            'hardware',
            r.id,
            { category_id: categoryId, quantity },
            profile?.display_name
          ).catch(console.error);
        }
      }

      onSaved();
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Erreur');
    } finally {
      setBusy(false);
    }
  }

  return (
    <div className="fixed inset-0 bg-black/30 flex items-center justify-center z-50 p-4" onClick={onClose}>
      <div className="card w-full max-w-2xl max-h-[90vh] overflow-auto" onClick={(e) => e.stopPropagation()}>
        <div className="flex items-center justify-between px-5 py-4 border-b border-ink-100 sticky top-0 bg-white rounded-t-xl">
          <h2 className="text-lg font-semibold text-ink-900 flex items-center gap-2">
<Laptop className="w-5 h-5 text-elyade-600" />
{item ? 'Modifier le matériel' : 'Ajouter du matériel'}
          </h2>
          <button onClick={onClose} className="btn-ghost p-1.5"><X className="w-5 h-5" /></button>
        </div>
        <form onSubmit={onSubmit} className="p-5 space-y-4">

<div className="grid grid-cols-2 gap-4">
  <div>
    <label className="label">Title</label>
    <input
      className="input"
      value={title}
      onChange={(e) => setTitle(e.target.value)}
      placeholder="ex: PC Dell Latitude 5450"
    />
  </div>

  <div>
    <label className="label">Catégorie</label>
    <select
      className="input"
      value={categoryId}
      onChange={(e) => setCategoryId(e.target.value)}
      required
    >
      <option value="">—</option>
      {data.hardwareCategories.map((c) => (
        <option key={c.id} value={c.id}>
          {c.label}
        </option>
      ))}
    </select>
  </div>
</div>

<div className="grid grid-cols-2 gap-4">
  <div>
    <label className="label">Utilisateur</label>
    <input
      className="input"
      value="Affectation gérée depuis les mouvements / attributions"
      disabled
    />
  </div>

  <div>
    <label className="label">Statut</label>
    <select
      className="input"
      value={status}
      onChange={(e) => setStatus(e.target.value as HardwareItem['status'])}
    >
      {Object.entries(HARDWARE_STATUS).map(([k, v]) => (
        <option key={k} value={k}>
          {v}
        </option>
      ))}
    </select>
  </div>
</div>

<div className="grid grid-cols-2 gap-4">
  <div>
    <label className="label">Fabricant</label>
    <select
      className="input"
      value={brand}
      onChange={(e) => setBrand(e.target.value)}
    >
      <option value="">—</option>
      {data.inventoryBrands.map((b: any) => (
        <option key={b.id} value={b.label}>
          {b.label}
        </option>
      ))}
    </select>
  </div>

  <div>
    <label className="label">Numéro de série</label>
    <input
      className="input"
      value={serial}
      onChange={(e) => setSerial(e.target.value)}
      placeholder="ex: SN-XXXX"
    />
  </div>
</div>

<div className="grid grid-cols-2 gap-4">
  <div>
    <label className="label">Modèle</label>
    <input
      className="input"
      value={model}
      onChange={(e) => setModel(e.target.value)}
      placeholder="ex: Latitude 5450"
    />
  </div>

  <div>
    <label className="label">OS</label>
    <select
      className="input"
      value={osId}
      onChange={(e) => setOsId(e.target.value)}
    >
      <option value="">—</option>
      {data.inventoryOperatingSystems.map((o: any) => (
        <option key={o.id} value={o.id}>
          {o.label}
        </option>
      ))}
    </select>
  </div>
</div>

<div className="grid grid-cols-3 gap-4">
  <div>
    <label className="label">Processeur</label>
    <select
      className="input"
      value={processorId}
      onChange={(e) => setProcessorId(e.target.value)}
    >
      <option value="">—</option>
      {data.inventoryProcessors.map((p: any) => (
        <option key={p.id} value={p.id}>
          {p.label}
        </option>
      ))}
    </select>
  </div>

  <div>
    <label className="label">Mémoire</label>
    <select
      className="input"
      value={memoryId}
      onChange={(e) => setMemoryId(e.target.value)}
    >
      <option value="">—</option>
      {data.inventoryMemories.map((m: any) => (
        <option key={m.id} value={m.id}>
          {m.label}
        </option>
      ))}
    </select>
  </div>

  <div>
    <label className="label">Taille</label>
    <select
      className="input"
      value={sizeId}
      onChange={(e) => setSizeId(e.target.value)}
    >
      <option value="">—</option>
      {data.inventorySizes.map((s: any) => (
        <option key={s.id} value={s.id}>
          {s.label}
        </option>
      ))}
    </select>
  </div>
</div>

<label className="flex items-center gap-2">
  <input
    type="checkbox"
    checked={hdmi}
    onChange={(e) => setHdmi(e.target.checked)}
  />
  <span>HDMI</span>
</label>

<label className="flex items-center gap-2">
  <input
    type="checkbox"
    checked={displayport}
    onChange={(e) => setDisplayport(e.target.checked)}
  />
  <span>DisplayPort</span>
</label>

<label className="flex items-center gap-2">
  <input
    type="checkbox"
    checked={usbC}
    onChange={(e) => setUsbC(e.target.checked)}
  />
  <span>USB‑C</span>
</label>


<div className="grid grid-cols-2 gap-4">
  <div>
    <label className="label">Date d'achat</label>
    <input
      type="date"
      className="input"
      value={purchaseDate}
      onChange={(e) => setPurchaseDate(e.target.value)}
    />
  </div>

  <div>
    <label className="label">Numéro de facture</label>
    <input
      className="input"
      value={invoiceNumber}
      onChange={(e) => setInvoiceNumber(e.target.value)}
    />
  </div>
</div>

<div className="grid grid-cols-2 gap-4">
  <div>
    <label className="label">Valeur achat</label>
    <input
      type="number"
      step="0.01"
      className="input"
      value={purchaseValue}
      onChange={(e) => setPurchaseValue(e.target.value)}
    />
  </div>

  <div>
    <label className="label">Fournisseur</label>
    <select
      className="input"
      value={supplierId}
      onChange={(e) => setSupplierId(e.target.value)}
    >
      <option value="">—</option>
      {data.inventorySuppliers.map((s: any) => (
        <option key={s.id} value={s.id}>
          {s.label}
        </option>
      ))}
    </select>
  </div>
</div>

<div className="grid grid-cols-2 gap-4">
  <div>
    <label className="label">Budget</label>
    <select
      className="input"
      value={budgetId}
      onChange={(e) => setBudgetId(e.target.value)}
    >
      <option value="">—</option>
      {data.inventoryBudgets.map((b: any) => (
        <option key={b.id} value={b.id}>
          {b.label}
        </option>
      ))}
    </select>
  </div>

  <div>
    <label className="label">Date d'expiration garantie</label>
    <input
      type="date"
      className="input"
      value={warrantyExpirationDate}
      onChange={(e) => setWarrantyExpirationDate(e.target.value)}
    />
  </div>
</div>

<div className="grid grid-cols-2 gap-4">
  <div>
    <label className="label">Numéro d'immobilisation</label>
    <input
      className="input"
      value={assetNumber}
      onChange={(e) => setAssetNumber(e.target.value)}
    />
  </div>

</div>


          {error && <div className="rounded-lg bg-red-50 border border-red-200 px-3 py-2 text-sm text-red-700">{error}</div>}
          <div className="flex justify-end gap-2 pt-2">
            <button type="button" onClick={onClose} className="btn-secondary">Annuler</button>
<button type="submit" className="btn-primary" disabled={busy}>
  {busy
    ? (item ? 'Enregistrement…' : 'Ajout…')
    : (item ? 'Enregistrer' : 'Ajouter')}
</button>

          </div>
        </form>
      </div>
    </div>
  );
}
function ReassignDialog({
  onClose,
  onSaved,
}: {
  onClose: () => void;
  onSaved: () => void;
}) {
  const data = useData();

  const [employeeId, setEmployeeId] = useState('');
const [employeeSearch, setEmployeeSearch] = useState('');
const [replacementByHardwareId, setReplacementByHardwareId] = useState<Record<string, string>>({});
const [oldStatusByHardwareId, setOldStatusByHardwareId] = useState<Record<string, string>>({});
const filteredEmployees = useMemo(() => {
  return data.employees
    .filter((e) => e.is_active)
    .filter((e) =>
      `${e.last_name} ${e.first_name}`
        .toLowerCase()
        .includes(employeeSearch.toLowerCase())
    )
    .sort((a, b) =>
      `${a.last_name} ${a.first_name}`.localeCompare(
        `${b.last_name} ${b.first_name}`
      )
    );
}, [employeeSearch, data.employees]);

  const activeAssignments = useMemo(() => {
    if (!employeeId) return [];

    return data.assignments.filter(
      (a) =>
        a.employee_id === employeeId &&
        !a.returned_at
    );
  }, [employeeId, data.assignments]);

  return (
    <div
      className="fixed inset-0 bg-black/30 flex items-center justify-center z-50 p-4"
      onClick={onClose}
    >
      <div
        className="card w-full max-w-5xl max-h-[90vh] overflow-auto"
        onClick={(e) => e.stopPropagation()}
      >
        <div className="p-5 border-b">
          <h2 className="text-lg font-semibold">
            Réaffectation de matériel
          </h2>
        </div>

        <div className="p-5 space-y-6">

          <div>
            <label className="label">
              Collaborateur
            </label>


<input
  className="input"
  placeholder="Rechercher un collaborateur..."
  value={employeeSearch}
  onChange={(e) => setEmployeeSearch(e.target.value)}
/>

<div className="mt-2 border rounded-lg max-h-60 overflow-auto">
  {filteredEmployees.map((employee) => (
    <button
      key={employee.id}
      type="button"
      onClick={() => {
        setEmployeeId(employee.id);
        setEmployeeSearch(
          `${employee.last_name} ${employee.first_name}`
        );
      }}
      className={`w-full text-left px-3 py-2 hover:bg-elyade-50 ${
        employee.id === employeeId
          ? 'bg-elyade-100'
          : ''
      }`}
    >
      {employee.last_name} {employee.first_name}
    </button>
  ))}
</div>


          </div>

          {employeeId && (
            <div className="space-y-3">

              <h3 className="font-semibold">
                Matériel actuellement affecté
              </h3>

              {activeAssignments.length === 0 && (
                <div className="text-sm text-ink-500">
                  Aucun matériel affecté
                </div>
              )}

              {activeAssignments.map((assignment) => {

                const hardware =
                  data.hardware.find(
                    (h) =>
                      h.id === assignment.hardware_item_id
                  );

                if (!hardware) return null;

                const category =
                  data.hardwareCategories.find(
                    (c) =>
                      c.id === hardware.category_id
                  );

return (
  <div
    key={assignment.id}
    className="border rounded-lg p-4 space-y-4"
  >
    <div>
      <div className="font-medium">
        {category?.label ?? 'Catégorie inconnue'}
      </div>

      <div className="text-sm text-ink-600 mt-1">
        {hardware.title ??
          hardware.model ??
          hardware.serial_number ??
          hardware.id}
      </div>

      <div className="text-xs text-ink-400 mt-1">
        N° série : {hardware.serial_number ?? '—'}
      </div>
    </div>

    <div>
      <label className="label">
        Nouveau matériel
      </label>

<select
  className="input"
  value={replacementByHardwareId[hardware.id] ?? ''}
  onChange={(e) =>
    setReplacementByHardwareId((prev) => ({
      ...prev,
      [hardware.id]: e.target.value,
    }))
  }
>
        <option value="">
          Aucun changement
        </option>

        {data.hardware
          .filter(
            (h) =>
              h.category_id === hardware.category_id &&
              h.status === 'in_stock' &&
              h.id !== hardware.id
          )
          .map((h) => (
            <option
              key={h.id}
              value={h.id}
            >
              {(h.title || h.model || h.serial_number || h.id)}
            </option>
          ))}
      </select>
    </div>

    <div>
      <label className="label">
        Statut de l'ancien matériel
      </label>

<select
  className="input"
  value={oldStatusByHardwareId[hardware.id] ?? 'being_reinstalled'}
  onChange={(e) =>
    setOldStatusByHardwareId((prev) => ({
      ...prev,
      [hardware.id]: e.target.value,
    }))
  }
>
        <option value="in_stock">
          En stock
        </option>

        <option value="being_reinstalled">
          En réinstallation
        </option>

        <option value="defective">
          Défectueux
        </option>

        <option value="retired">
          Réformé
        </option>
      </select>
    </div>
  </div>
);


              })}
            </div>
          )}

        </div>

        <div className="p-5 border-t flex justify-end gap-2">
          <button
            onClick={onClose}
            className="btn-secondary"
          >
            Fermer
          </button>

<button
  type="button"
  className="btn-primary"
  onClick={async () => {
    try {

      const changes = activeAssignments
        .map((assignment) => ({
          old_hardware_id: assignment.hardware_item_id,
          new_hardware_id:
            replacementByHardwareId[
              assignment.hardware_item_id
            ] || null,
          old_status:
            oldStatusByHardwareId[
              assignment.hardware_item_id
            ] || 'being_reinstalled',
        }))
        .filter((c) => c.new_hardware_id);

      if (changes.length === 0) {
        alert('Aucun remplacement sélectionné');
        return;
      }

      const res = await fetch(
        '/api/hardware-reassign',
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            employee_id: employeeId,
            changes,
          }),
        }
      );

      if (!res.ok) {
        const err = await res.json().catch(() => ({
          error: 'Erreur réaffectation',
        }));

        throw new Error(
          err.error ?? 'Erreur réaffectation'
        );
      }

      alert('Réaffectation réalisée');

      onSaved();
      onClose();

    } catch (e) {

      alert(
        e instanceof Error
          ? e.message
          : 'Erreur réaffectation'
      );

    }
  }}
>
  Valider la réaffectation
</button>


 </div>
      </div>
    </div>
  );
}
