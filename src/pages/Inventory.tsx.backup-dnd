const filtered = useMemo(
    () =>
      data.hardware.filter(
        (h) =>
          (catFilter === 'all' || h.category_id === catFilter) &&
          (statusFilter === 'all' || h.status === statusFilter),
      ),
    [data.hardware, catFilter, statusFilter],
  );

  const catLabel = useMemo(() => {
    const m = new Map<string, string>();
    for (const c of data.hardwareCategories) m.set(c.id, c.label);
    return m;
  }, [data.hardwareCategories]);

function lookupLabel(rows: any[], id: string | null | undefined) {
  if (!id) return '—';
  return rows.find((r) => r.id === id)?.label ?? '—';
}

async function assignHardwareToEmployee() {

  if (!selectedHardware || !selectedEmployeeId) {
    alert('Sélectionnez un collaborateur');
    return;
  }

  const res = await fetch(
    '/api/assignments',
    {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        employee_id: selectedEmployeeId,
        hardware_item_id: selectedHardware.id,
      }),
    }
  );

  if (!res.ok) {
    const err = await res.json().catch(() => ({
      error: 'Erreur affectation',
    }));

    alert(
      err.error ?? 'Erreur affectation'
    );

    return;
  }

  await fetch(
    `/api/hardware-items/${selectedHardware.id}`,
    {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        status: 'assigned',
      }),
    }
  );

  setShowAssignUser(false);
  setSelectedEmployeeId('');
  setSelectedHardware(null);

  data.reload();
}

async function assignHardwareToGroup() {

  if (!selectedHardware) {
    alert('Aucun matériel sélectionné');
    return;
  }

  if (!selectedGroup) {
    alert('Sélectionnez un groupe');
    return;
  }

  const group = microsoftGroups.find(
    (g) => g.id === selectedGroup
  );

  if (!group) {
    alert('Groupe introuvable');
    return;
  }

  const res = await fetch(
    '/api/hardware-assignments/group',
    {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        hardware_item_id:
          selectedHardware.id,

        group_name:
          group.displayName
      }),
    }
  );

  if (!res.ok) {

    const err =
      await res.json().catch(() => ({
        error:
          'Erreur affectation groupe',
      }));

    alert(
      err.error ??
      'Erreur affectation groupe'
    );

    return;
  }

  setShowAssignGroup(false);

  setSelectedGroup('');

  setSelectedHardware(null);

  data.reload();
}



async function assignHardwareToGroup() {

  if (
    !selectedHardware ||
    !selectedGroup
  ) {
    alert(
      'Sélectionnez un groupe'
    );
    return;
  }

  const group = microsoftGroups.find(
    (g) => g.id === selectedGroup
  );

  const res = await fetch(
    '/api/assignments/group',
    {
      method: 'POST',
      headers: {
        'Content-Type':
          'application/json',
      },
      body: JSON.stringify({
        hardware_item_id:
          selectedHardware.id,

        group_id:
          selectedGroup,

        group_name:
          group?.displayName,
      }),
    }
  );

  if (!res.ok) {
    alert(
      'Erreur affectation groupe'
    );
    return;
  }

  setShowAssignGroup(false);

  setSelectedGroup('');

  setSelectedHardware(null);

  data.reload();
}




async function changeStatus(h: HardwareItem, status: HardwareItem['status']) {
  const res = await fetch(`/api/hardware-items/${h.id}`, {
    method: 'PATCH',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ status }),
  });

  if (!res.ok) {
    const err = await res.json().catch(() => ({ error: 'Erreur de mise à jour' }));
    alert(err.error ?? 'Erreur de mise à jour');
    return;
  }

  await logAudit('update', 'hardware', h.id, { status, from: h.status }, profile?.display_name).catch(console.error);

  data.reload();
}


async function removeItem(h: HardwareItem) {
  if (!confirm(`Supprimer définitivement cet équipement (${h.serial_number || h.reference || h.id}) ?`)) return;

  const res = await fetch(`/api/hardware-items/${h.id}`, {
    method: 'DELETE',
  });

  if (!res.ok) {
    const err = await res.json().catch(() => ({ error: 'Erreur de suppression' }));
    alert(err.error ?? 'Erreur de suppression');
    return;
  }

  await logAudit('delete', 'hardware', h.id, { serial: h.serial_number }, profile?.display_name).catch(console.error);

  data.reload();
}

function editItem(item: HardwareItem) {
  setSelectedItem(item);
