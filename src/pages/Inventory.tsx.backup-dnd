      <h2 className="text-lg font-semibold mb-4">
        Affecter à un groupe Microsoft
      </h2>

      <select
        className="input w-full"
        value={selectedGroup}
        onChange={(e) =>
          setSelectedGroup(e.target.value)
        }
      >
        <option value="">
          Sélectionner...
        </option>

        {microsoftGroups.map((group) => (
          <option
            key={group.id}
            value={group.id}
          >
            {group.displayName}
          </option>
        ))}
      </select>

      <div className="flex justify-end gap-2 mt-4">

        <button
          className="btn-secondary"
          onClick={() =>
            setShowAssignGroup(false)
          }
        >
          Annuler
        </button>

        <button
          className="btn-primary"
          onClick={assignHardwareToGroup}
        >
          Affecter
        </button>

      </div>

    </div>

  </div>
)}

{showColumns && (

  <div
    className="fixed inset-0 bg-black/30 flex items-center justify-center z-50"
    onClick={() => setShowColumns(false)}
  >

    <div
      className="card w-full max-w-xl p-5"
      onClick={(e) => e.stopPropagation()}
    >

      <h2 className="text-lg font-semibold mb-4">
        Colonnes affichées
      </h2>


<DndContext
  sensors={sensors}
  collisionDetection={closestCenter}
  onDragEnd={handleColumnDragEnd}
>
  <SortableContext
    items={columnOrder}
    strategy={horizontalListSortingStrategy}
  >
    <div className="space-y-2 max-h-96 overflow-auto">

      {columnOrder.map((columnKey) => {
        const column = allColumns.find(
          (item) => item.key === columnKey
        );

        if (!column) {
          return null;
        }

        return (
          <SortableColumnItem
            key={column.key}
            column={column}
            visible={visibleColumns.includes(
              column.key
            )}
            onVisibleChange={(
              key,
              checked
            ) => {
              if (checked) {
                setVisibleColumns(
                  (currentColumns) =>
                    currentColumns.includes(key)
                      ? currentColumns
                      : [
                          ...currentColumns,
                          key
                        ]
                );
              } else {
                setVisibleColumns(
                  (currentColumns) =>
                    currentColumns.filter(
                      (currentKey) =>
                        currentKey !== key
                    )
                );
              }
            }}
          />
        );
      })}

    </div>
  </SortableContext>
</DndContext>



      <div className="flex justify-end mt-4">

        <button
          className="btn-primary"
          onClick={() => setShowColumns(false)}
        >
          Fermer
        </button>

      </div>

    </div>

  </div>

)}


</div>
);
}

function SortableColumnItem({
  column,
  visible,
  onVisibleChange
}: {
  column: {
    key: string;
    label: string;
  };
  visible: boolean;
  onVisibleChange: (
    key: string,
    checked: boolean
  ) => void;
}) {
  const {
    attributes,
    listeners,
    setNodeRef,
    transform,
    transition,
    isDragging
  } = useSortable({
    id: column.key
  });

  const style: React.CSSProperties = {
    transform: CSS.Transform.toString(transform),
    transition,
    opacity: isDragging ? 0.5 : 1
  };

  return (
    <div
      ref={setNodeRef}
      style={style}
      className="
        flex
        items-center
        gap-3
        border
        rounded-lg
        px-3
        py-2
        bg-white
      "
    >
      <button
        type="button"
        className="
          cursor-grab
          active:cursor-grabbing
          text-ink-400
          hover:text-ink-700
          px-1
        "
        title={`Déplacer la colonne ${column.label}`}
        {...attributes}
        {...listeners}
      >
        ☰
      </button>

      <input
        type="checkbox"
        checked={visible}
        onChange={(e) =>
          onVisibleChange(
            column.key,
            e.target.checked
          )
        }
      />

      <span className="flex-1">
        {column.label}
      </span>
    
  );
}

