        where = '';
      } else if (role === 'client') {
        where = 'WHERE p.client_account_id = $1';
        params = [accountId];
      } else {
        where = 'WHERE EXISTS (SELECT 1 FROM project_assignments pa WHERE pa.project_id = p.id AND pa.account_id = $1)';
